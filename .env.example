# ============================================================
# 配置模板：复制本文件为 backend/.env，并填入真实值。
# 真实 .env 已被 .gitignore 排除，不会上传到 git 仓库。
# ============================================================

# ---- 阿里云百炼 DashScope（必填）----
# API Key 申请：阿里云百炼控制台 -> API-KEY 管理 -> 创建
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 对话模型（省钱可用 qwen-turbo，演示用 qwen-plus）
MODEL_CHAT=qwen-plus
MODEL_EMBEDDING=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# 重排模型（阿里云已下架 gte-rerank，官方推荐 qwen3-rerank）
MODEL_RERANK=qwen3-rerank
RERANK_TOP_N=5
# 相关度阈值（评分范围 0~1）：≥阈值严格模式带引用作答；
# <阈值按意图分流（商品关键词→兜底话术，其他→自由对话）
RERANK_THRESHOLD=0.35

# ---- 安全 ----
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=please-generate-a-random-secret
JWT_EXPIRE_HOURS=24

# ---- 管理员（首次启动自动创建）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# ---- 存储 ----
# 默认值即下方配置，一般无需修改；路径相对 backend/ 目录
# DATABASE_URL=sqlite:///./data/app.db
# CHROMA_DIR=./data/chroma
# UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
MAX_CHUNKS_PER_DOC=5000

# ---- 检索参数（分块/检索调优入口）----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
VECTOR_TOP_K=20
BM25_TOP_K=20
RRF_K=60
FINAL_TOP_K=5
CONTEXT_MAX_CHARS=6000
HISTORY_TURNS=3

# ---- 缓存与限流 ----
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=128
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_LOGIN_PER_MIN=5

# ---- 跨域（前端开发服务器地址）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
